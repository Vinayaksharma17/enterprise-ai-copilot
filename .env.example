# Environment Configuration
NODE_ENV=development

# Port Configuration
FRONTEND_PORT=3000
BACKEND_PORT=5000
MONGODB_PORT=27017
CHROMA_PORT=8000
REDIS_PORT=6379

# MongoDB Configuration
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/enterprise-ai-copilot?authSource=admin
MONGODB_DATABASE=enterprise-ai-copilot
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123

# ChromaDB Configuration
CHROMA_URL=http://chromadb:8000

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# Admin Bootstrap (for seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=Administrator
ADMIN_DEPARTMENT=Admin

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:5000/api/v1

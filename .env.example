# Environment Configuration
NODE_ENV=development

# Port Configuration
FRONTEND_PORT=3000
BACKEND_PORT=5000
MONGODB_PORT=27017
CHROMA_PORT=8000
REDIS_PORT=6379

# MongoDB Configuration
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/enterprise-ai-copilot?authSource=admin
MONGODB_DATABASE=enterprise-ai-copilot
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123

# ChromaDB Configuration
CHROMA_URL=http://chromadb:8000
CHROMA_COLLECTION=documents

# Redis Configuration
REDIS_URL=redis://redis:6379

# Document Ingestion Configuration
# UPLOAD_DIR must be a writable path inside the backend container (mounted as a
# named volume so uploads survive container recreation).
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_BYTES=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# RAG Configuration
RAG_TOP_K=5
# Chroma returns distances (lower = more similar). 0 disables threshold filtering.
RAG_SIMILARITY_THRESHOLD=0
RAG_MAX_HISTORY_MESSAGES=6

# LLM / Embeddings Provider Configuration (OpenAI-compatible)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
# Optional: point to an OpenAI-compatible endpoint (e.g. a local/self-hosted gateway).
LLM_BASE_URL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
# Optional: falls back to LLM_BASE_URL when empty.
EMBEDDING_BASE_URL=

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# Admin Bootstrap (for seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=Administrator
ADMIN_DEPARTMENT=Admin

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:5000/api/v1

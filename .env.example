# Environment Configuration
NODE_ENV=development

# Port Configuration
FRONTEND_PORT=3000
BACKEND_PORT=5000
MONGODB_PORT=27017
CHROMA_PORT=8000
REDIS_PORT=6379
# Only used if you uncomment the ollama port binding for local diagnostics.
OLLAMA_PORT=11434

# MongoDB Configuration
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/enterprise-ai-copilot?authSource=admin
MONGODB_DATABASE=enterprise-ai-copilot
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123

# ChromaDB Configuration
CHROMA_URL=http://chromadb:8000
CHROMA_COLLECTION=documents

# Redis Configuration
REDIS_URL=redis://redis:6379

# Document Ingestion Configuration
# UPLOAD_DIR must be a writable path inside the backend container (mounted as a
# named volume so uploads survive container recreation).
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_BYTES=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# RAG Configuration
RAG_TOP_K=5
# Chroma returns distances (lower = more similar). 0 disables threshold filtering.
RAG_SIMILARITY_THRESHOLD=0
RAG_MAX_HISTORY_MESSAGES=6

# LLM / Embeddings Provider Configuration
# Local (default): run models on Ollama. No API keys required.
# Cloud: set LLM_PROVIDER=openai and EMBEDDING_PROVIDER=openai, then set keys.
# Supported providers: ollama | openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0
# Cloud-only credentials (leave blank for Ollama):
LLM_API_KEY=
# Optional: point a cloud provider at an OpenAI-compatible endpoint.
LLM_BASE_URL=

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Cloud-only credentials (leave blank for Ollama):
EMBEDDING_API_KEY=
# Optional: falls back to LLM_BASE_URL when empty.
EMBEDDING_BASE_URL=

# Ollama runtime (used when LLM_PROVIDER or EMBEDDING_PROVIDER is "ollama")
# In Docker Compose the backend reaches Ollama over the internal network.
OLLAMA_BASE_URL=http://ollama:11434
# Per-request timeout (ms). Local CPU inference is slow; keep this generous.
OLLAMA_TIMEOUT_MS=120000
# Bounded concurrency and wait queue; overload returns a clear 503 error.
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_MAX_QUEUE=16
# Retries for transient Ollama failures (container restarting, model loading).
OLLAMA_RETRIES=2
# How long a model stays loaded after a request (e.g. 5m, 30s, -1 = forever).
OLLAMA_KEEP_ALIVE=5m
# Context window and max generated tokens for the chat model.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# Admin Bootstrap (for seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=Administrator
ADMIN_DEPARTMENT=Admin

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:5000/api/v1
